# 忽略所有 .log 文件
*.log

# 忽略特定目录
old/
config_back/
__pycache__/
.claude
test/*

# 忽略特定文件
config.toml
图像到图像（简易）.json
文生图（效果最好的一个）.json
.env
nul
008.jpg
requirements.txt

# 忽略特定扩展名的文件（递归）
**/*.tmp

# 不忽略某个特定文件（例外规则）
#!important.log

#忽略ai生成的test文件（根目录临时脚本）
/test_*

# ===== 主人本地副本规则（2026-08-19 重写：从豁免改为严格忽略）=====
# 主人哲学变更：以前豁免 config.toml / cookies / data 入库方便回溯；现在改为默认忽略。
# 历史 commit 中的真值密钥暂保留（git filter-repo 标记为 Phase 2，待主人定夺），
# 但未来增量不再入库；plugin-level CLAUDE.md 旧 SHA 引用仍有效。
#
# 默认忽略敏感文件（含真值密钥）
config.toml
config.toml.bak
config.toml.bak.*
config.toml.local
config.local.toml
cookies-*.json
data/

# 允许追踪的例外（按需取消注释；本仓库作为 MaiBot 插件 source of truth）：
#!config.example.toml
#!config.toml.example
#!data/.gitkeep
# OMC CLI 状态文件（不纳入仓库）
.omc/
